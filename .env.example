# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real keys.
# On Vercel, add the same names under Project Settings -> Environment Variables.

# Supabase (leave blank to run in local offline/mock mode)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# EmailJS — task-assignment email notifications (see EMAILJS_SETUP.md)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Google Gemini — AI Sheet Import on the Content Calendar.
# The Gemini key is NOT a VITE_ variable. The Developer saves it
# in the CRM ("Gemini Key" button, needs supabase_secure_gemini_key.sql) and it stays on the server.
# The server function api/gemini.js needs this Vercel-only variable (never commit it, never prefix it VITE_):
#   SUPABASE_SERVICE_ROLE_KEY=
# Optional Vercel-only fallback key if none is saved in the CRM:  GEMINI_API_KEY=
# Optional: override the model (default gemini-2.5-flash)
VITE_GEMINI_MODEL=
