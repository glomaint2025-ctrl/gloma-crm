# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real keys.
# On Vercel, add the same names under Project Settings -> Environment Variables.

# Supabase (leave blank to run in local offline/mock mode)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# EmailJS — task-assignment email notifications (see EMAILJS_SETUP.md)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Google Gemini — AI Sheet Import on the Content Calendar.
# Optional fallback. Normally the Developer saves the key once from the Content Calendar
# ("Gemini Key" button) and everyone uses it (needs supabase_add_gemini_key.sql).
# Get a key at https://aistudio.google.com/apikey and restrict it / set a quota in Google AI Studio.
VITE_GEMINI_API_KEY=
# Optional: override the model (default gemini-2.5-flash)
VITE_GEMINI_MODEL=
