# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real keys.
# On Vercel, add the same names under Project Settings -> Environment Variables.

# Supabase (leave blank to run in local offline/mock mode)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# EmailJS — task-assignment email notifications (see EMAILJS_SETUP.md)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Google Gemini — AI Sheet Import on the Content Calendar.
# Get a key at https://aistudio.google.com/apikey. The key is bundled into the app, so
# only people who can log in can reach it, but restrict it in Google AI Studio and set a
# spending/quota limit. Optional: users can also paste their own key inside the import
# window (stored only in that browser).
VITE_GEMINI_API_KEY=
# Optional: override the model (default gemini-2.5-flash)
VITE_GEMINI_MODEL=
